{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lorkhan.invalid/schemas/source-ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "role", "license", "state", "pin", "proof"], "properties": {
      "id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "license": {"type": ["string", "null"]},
      "state": {"enum": ["PINNED", "DEFERRED"]}, "pin": {"type": ["string", "null"]}, "proof": {"type": "string", "minLength": 1}, "resume_when": {"type": "string"}
    }}}
  }
}
