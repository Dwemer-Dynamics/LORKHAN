{
  "$id": "https://almsivi.invalid/schemas/v1/error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "action_disabled",
        "action_result_expired",
        "action_result_mismatch",
        "cursor_expired",
        "duplicate_conflict",
        "forbidden",
        "internal_error",
        "invalid_idempotency_key",
        "invalid_schema",
        "media_unavailable",
        "not_found",
        "payload_too_large",
        "provider_action_not_allowed",
        "provider_invalid_action",
        "provider_invalid_output",
        "provider_timeout",
        "provider_unavailable",
        "rate_limited",
        "request_mismatch",
        "service_unavailable",
        "stale_generation",
        "terminal_turn",
        "turn_terminal",
        "unauthorized",
        "unknown_action",
        "unknown_session",
        "unknown_turn"
      ],
      "type": "string"
    },
    "correlation_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "message": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "retriable": {
      "type": "boolean"
    },
    "retry_after_ms": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "const": "almsivi.error.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "code",
    "message",
    "correlation_id",
    "retriable"
  ],
  "type": "object"
}
