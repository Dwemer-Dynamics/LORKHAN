{
  "$id": "https://almsivi.invalid/schemas/v1/action-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "completed_at": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/timestamp"
    },
    "generation": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/generation"
    },
    "message_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "observed": {
      "$comment": "Deferred typed observed result contents; bounded envelope only.",
      "maxProperties": 64,
      "type": "object"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "schema": {
      "const": "almsivi.action-result.v1",
      "type": "string"
    },
    "session_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "status": {
      "enum": [
        "cancelled",
        "failed",
        "rejected",
        "succeeded",
        "timed_out"
      ],
      "type": "string"
    },
    "turn_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    }
  },
  "required": [
    "schema",
    "message_id",
    "request_id",
    "action_id",
    "turn_id",
    "session_id",
    "generation",
    "status",
    "reason_code",
    "observed",
    "completed_at"
  ],
  "type": "object"
}
