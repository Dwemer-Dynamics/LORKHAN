{
  "$id": "https://almsivi.invalid/schemas/v1/turn.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_fingerprint": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/content_fingerprint"
    },
    "created_at": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/timestamp"
    },
    "generation": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/generation"
    },
    "installation_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "message_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/identity"
          },
          "maxItems": 12,
          "type": "array"
        },
        "context": {
          "$comment": "Deferred bounded context snapshot shape.",
          "maxProperties": 256,
          "type": "object"
        },
        "input": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "stt",
                "text"
              ],
              "type": "string"
            },
            "language": {
              "maxLength": 35,
              "minLength": 2,
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "type": "string"
            },
            "text": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text",
            "language"
          ],
          "type": "object"
        },
        "recent_action_results": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
              },
              "completed_at": {
                "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/timestamp"
              },
              "observed": {
                "$comment": "Deferred typed observed result contents; bounded envelope only.",
                "maxProperties": 64,
                "type": "object"
              },
              "reason_code": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "enum": [
                  "cancelled",
                  "failed",
                  "rejected",
                  "succeeded",
                  "timed_out"
                ],
                "type": "string"
              }
            },
            "required": [
              "action_id",
              "status",
              "reason_code",
              "observed",
              "completed_at"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        },
        "speaker": {
          "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/identity"
        },
        "target": {
          "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/identity"
        },
        "ui_source": {
          "type": "string"
        }
      },
      "required": [
        "input",
        "speaker",
        "target",
        "audience",
        "context",
        "recent_action_results",
        "ui_source"
      ],
      "type": "object"
    },
    "playthrough_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "profile_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "request_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "runtime": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/runtime"
    },
    "schema": {
      "const": "almsivi.turn.v1",
      "type": "string"
    },
    "session_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "turn_id": {
      "$ref": "https://almsivi.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    }
  },
  "required": [
    "schema",
    "message_id",
    "request_id",
    "turn_id",
    "installation_id",
    "profile_id",
    "playthrough_id",
    "session_id",
    "generation",
    "created_at",
    "runtime",
    "content_fingerprint",
    "payload"
  ],
  "type": "object"
}
