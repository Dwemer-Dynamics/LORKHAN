+    // Queue the actual clicked player text before the resulting NPC response event.
+    void LuaManager::onLorkhanDialogueChoice(const MWWorld::Ptr& actor, const std::string& text)
+    {
+        if (text.empty() || text.size() > 4096 || actor.isEmpty())
+            return;
+        mLua.protectedCall([&](LuaUtil::LuaView& view) {
+            sol::table data = view.newTable();
+            data["actor"] = LObject(actor);
+            MWScript::InterpreterContext context(&actor.getRefData().getLocals(), actor);
+            data["text"] = Interpreter::fixDefinesDialog(text, context);
+            sendLocalEvent(mPlayer, "LorkhanDialogueChoice", data);
+        });
+    }
