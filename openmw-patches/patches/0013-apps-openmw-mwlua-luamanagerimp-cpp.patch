+    // Observe only completed player transfers, copying item/source text before Lua handles the event.
+    void LuaManager::onLorkhanItemPickup(const MWWorld::Ptr& player, const MWWorld::Ptr& item,
+        int count, const MWWorld::Ptr& source)
+    {
+        if (mPlayer.isEmpty() || player != mPlayer || item.isEmpty() || count <= 0
+            || mLorkhanItemPickupCount >= 64) return;
+        const std::string recordId = item.getCellRef().getRefId().serializeText();
+        const std::string name{item.getClass().getName(item)};
+        const int value = item.getClass().getValue(item);
+        if (recordId.empty() || recordId.size() > 256 || name.empty() || name.size() > 256 || value < 0) return;
+        mLua.protectedCall([&](LuaUtil::LuaView& view) {
+            const auto scope = lorkhanObservationScope();
+            if (!scope) return;
+            ++mLorkhanItemPickupCount;
+            sol::table data = view.newTable();
+            data["player"] = LObject(player);
+            data["itemRecordId"] = recordId; data["itemName"] = name;
+            data["count"] = count; data["unitValue"] = value;
+            data["sourceKind"] = source.isEmpty() ? "world" : source.getClass().isActor() ? "actor" : "container";
+            if (!source.isEmpty()) {
+                const std::string sourceId = source.getCellRef().getRefId().serializeText();
+                const std::string sourceName{source.getClass().getName(source)};
+                if (!sourceId.empty() && sourceId.size() <= 256 && !sourceName.empty() && sourceName.size() <= 256) {
+                    sol::table descriptor = view.newTable();
+                    descriptor["recordId"] = sourceId; descriptor["displayName"] = sourceName;
+                    data["source"] = descriptor;
+                }
+            }
+            const auto timeManager = MWBase::Environment::get().getWorld()->getTimeManager();
+            data["gameTime"] = timeManager->getGameTime();
+            const auto stamp = timeManager->getEpochTimeStamp();
+            const lorkhan::LoadedSaveCalendar captured{stamp.mYear, stamp.mMonth, stamp.mDay, stamp.mGameHour};
+            if (captured.valid())
+            {
+                sol::table calendar = view.newTable();
+                calendar["year"] = captured.year;
+                calendar["month"] = captured.month;
+                calendar["day"] = captured.day;
+                calendar["hour"] = captured.hour;
+                data["calendar"] = calendar;
+            }
+            data["sessionId"] = scope->sessionId; data["generation"] = scope->generation;
+            sendLocalEvent(mPlayer, "LorkhanItemPickup", data);
+        });
+    }
