+    // Observe one committed player barter; TradeWindow copied every line before the item transfer.
+    void LuaManager::onLorkhanBarterTrade(const MWWorld::Ptr& merchant, const std::vector<LorkhanBarterLine>& received,
+        const std::vector<LorkhanBarterLine>& gave, int goldToPlayer)
+    {
+        if (mPlayer.isEmpty() || merchant.isEmpty() || merchant == mPlayer || !merchant.getClass().isActor()
+            || mLorkhanBarterCount >= 8 || received.size() > 32 || gave.size() > 32
+            || (received.empty() && gave.empty()) || goldToPlayer < -2147483647) return;
+        for (const auto* lines : { &received, &gave })
+            for (const LorkhanBarterLine& line : *lines)
+                if (line.recordId.empty() || line.recordId.size() > 256 || line.name.empty() || line.name.size() > 256
+                    || line.count <= 0 || line.unitValue < 0) return;
+        mLua.protectedCall([&](LuaUtil::LuaView& view) {
+            const auto scope = lorkhanObservationScope();
+            if (!scope) return;
+            ++mLorkhanBarterCount;
+            const auto copyLines = [&](const std::vector<LorkhanBarterLine>& lines) {
+                sol::table result = view.newTable();
+                for (std::size_t index = 0; index < lines.size(); ++index)
+                {
+                    sol::table line = view.newTable();
+                    line["itemRecordId"] = lines[index].recordId; line["itemName"] = lines[index].name;
+                    line["count"] = lines[index].count; line["unitValue"] = lines[index].unitValue;
+                    result[index + 1] = line;
+                }
+                return result;
+            };
+            sol::table data = view.newTable();
+            data["player"] = LObject(mPlayer); data["merchant"] = LObject(merchant);
+            data["playerReceived"] = copyLines(received); data["playerGave"] = copyLines(gave);
+            data["goldToPlayer"] = goldToPlayer;
+            const auto timeManager = MWBase::Environment::get().getWorld()->getTimeManager();
+            data["gameTime"] = timeManager->getGameTime();
+            const auto stamp = timeManager->getEpochTimeStamp();
+            const lorkhan::LoadedSaveCalendar captured{stamp.mYear, stamp.mMonth, stamp.mDay, stamp.mGameHour};
+            if (captured.valid())
+            {
+                sol::table calendar = view.newTable();
+                calendar["year"] = captured.year;
+                calendar["month"] = captured.month;
+                calendar["day"] = captured.day;
+                calendar["hour"] = captured.hour;
+                data["calendar"] = calendar;
+            }
+            data["sessionId"] = scope->sessionId; data["generation"] = scope->generation;
+            sendLocalEvent(mPlayer, "LorkhanBarterTrade", data);
+        });
+    }
