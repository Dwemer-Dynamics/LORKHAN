+    // Copy a successful cast into the existing bounded-per-frame local event lane.
+    void LuaManager::onLorkhanSpellCast(const MWWorld::Ptr& caster, const MWWorld::Ptr& target,
+        const std::string& spellId, const std::string& spellName)
+    {
+        if (mPlayer.isEmpty() || caster.isEmpty() || !caster.getClass().isActor()
+            || mLorkhanSpellCastCount >= 64 || spellId.empty() || spellId.size() > 256
+            || spellName.empty() || spellName.size() > 256) return;
+        mLua.protectedCall([&](LuaUtil::LuaView& view) {
+            const auto scope = lorkhanObservationScope();
+            if (!scope) return;
+            ++mLorkhanSpellCastCount;
+            sol::table data = view.newTable();
+            data["caster"] = LObject(caster);
+            if (!target.isEmpty() && target.getClass().isActor()) data["target"] = LObject(target);
+            data["spellId"] = spellId; data["spellName"] = spellName;
+            const auto timeManager = MWBase::Environment::get().getWorld()->getTimeManager();
+            data["gameTime"] = timeManager->getGameTime();
+            const auto stamp = timeManager->getEpochTimeStamp();
+            const lorkhan::LoadedSaveCalendar captured{stamp.mYear, stamp.mMonth, stamp.mDay, stamp.mGameHour};
+            if (captured.valid())
+            {
+                sol::table calendar = view.newTable();
+                calendar["year"] = captured.year;
+                calendar["month"] = captured.month;
+                calendar["day"] = captured.day;
+                calendar["hour"] = captured.hour;
+                data["calendar"] = calendar;
+            }
+            data["sessionId"] = scope->sessionId; data["generation"] = scope->generation;
+            sendLocalEvent(mPlayer, "LorkhanSpellCast", data);
+        });
+    }
