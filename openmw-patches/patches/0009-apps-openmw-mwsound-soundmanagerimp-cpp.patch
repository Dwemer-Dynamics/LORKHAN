+        // Keep only the bounded trailing clip window; never decode an entire utterance up front.
+        class LorkhanTrimDecoder final : public SoundDecoder {
+            DecoderPtr mSource;
+            lorkhan::PlaybackClipWindow mWindow{0,0};
+            std::size_t mDelivered=0,mFrameBytes=1;
+            bool mEof=false;
+        public:
+            LorkhanTrimDecoder(DecoderPtr source,int start,int end):SoundDecoder(nullptr),mSource(std::move(source)) {
+                int rate;ChannelConfig channels;SampleType type;mSource->getInfo(&rate,&channels,&type);
+                mFrameBytes=framesToBytes(1,channels,type);
+                if(rate<=0||rate>384000||!mFrameBytes||mFrameBytes>32)throw std::runtime_error("invalid voice PCM format");
+                mWindow=lorkhan::PlaybackClipWindow(lorkhan::clipFrames(rate,start)*mFrameBytes,lorkhan::clipFrames(rate,end)*mFrameBytes);
+            }
+            void open(VFS::Path::NormalizedView) override { throw std::logic_error("prepared decoder only"); }
+            void close() override {mSource->close();mWindow=lorkhan::PlaybackClipWindow(0,0);mEof=true;}
+            std::string getName() override {return mSource->getName();}
+            void getInfo(int* rate,ChannelConfig* channels,SampleType* type) override {mSource->getInfo(rate,channels,type);}
+            std::size_t getSampleOffset() override {return mDelivered/mFrameBytes;}
+            std::size_t read(char* buffer,std::size_t bytes) override {
+                while(!mEof&&mWindow.available()<bytes){
+                    char chunk[16384];const auto amount=mSource->read(chunk,sizeof(chunk)/mFrameBytes*mFrameBytes);
+                    if(!amount){mEof=true;break;}
+                    mWindow.append(chunk,amount);
+                }
+                const auto count=mWindow.read(buffer,bytes);mDelivered+=count;return count;
+            }
+        };
 
