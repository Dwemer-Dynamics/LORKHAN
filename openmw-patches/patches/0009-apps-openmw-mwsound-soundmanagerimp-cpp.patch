+    bool SoundManager::sayAlmsiviMedia(
+        const MWWorld::ConstPtr& ptr, Files::IStreamPtr media, std::string_view name, float volumeBoost)
+    {
+        if (!mOutput->isInitialized())
+            return false;
+
+        DecoderPtr decoder = loadAlmsiviMedia(std::move(media), name);
+        if (!decoder)
+            return false;
+
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        const osg::Vec3f pos = world->getActorHeadTransform(ptr).getTrans();
+
+        stopSay(ptr);
+        StreamPtr sound = playVoice(std::move(decoder), pos, (ptr == MWMechanics::getPlayer()), volumeBoost);
+        if (!sound)
+            return false;
+
+        mSaySoundsQueue.emplace(ptr.mRef, SaySound{ ptr.mCell, std::move(sound) });
+        return true;
     }
 
