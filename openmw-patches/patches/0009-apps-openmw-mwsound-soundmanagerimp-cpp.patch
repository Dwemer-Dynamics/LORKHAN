+    osg::Vec3f SoundManager::lorkhanPosition(const MWWorld::ConstPtr& ptr) const
+    {
+        auto world=MWBase::Environment::get().getWorld();
+        auto delta=world->getActorHeadTransform(ptr).getTrans()-mListenerPos;
+        if(!mLorkhanPlayback.cameraBasedAudio){
+            const auto player=world->getPlayerPtr();
+            delta=world->getActorHeadTransform(ptr).getTrans()-world->getActorHeadTransform(player).getTrans();
+            const float yaw=player.getRefData().getPosition().rot[2];
+            const osg::Vec3f forward(std::sin(yaw),std::cos(yaw),0),right(std::cos(yaw),-std::sin(yaw),0);
+            const osg::Vec3f cameraRight=mListenerDir^mListenerUp;
+            delta=cameraRight*(delta*right)+mListenerDir*(delta*forward)+mListenerUp*delta.z();
+        }
+        if(mLorkhanPlayback.invertHeading)delta=-delta;
+        if(delta.normalize()==0)delta=mListenerDir;
+        return mListenerPos+delta*10.f;
+    }
+
+    float SoundManager::lorkhanGain(const MWWorld::ConstPtr& ptr) const
+    {
+        auto world=MWBase::Environment::get().getWorld();const bool head=ptr==world->getPlayerPtr();
+        const auto listener=mLorkhanPlayback.cameraBasedAudio?mListenerPos:osg::Vec3f(world->getActorHeadTransform(world->getPlayerPtr()).getTrans());
+        const float distance=(world->getActorHeadTransform(ptr).getTrans()-listener).length();
+        const auto& store=world->getStore().get<ESM::GameSetting>();
+        const float minimum=std::max(1.f,store.find("fAudioVoiceDefaultMinDistance")->mValue.getFloat()*store.find("fAudioMinDistanceMult")->mValue.getFloat());
+        const float maximum=std::max(minimum+1,store.find("fAudioVoiceDefaultMaxDistance")->mValue.getFloat()*store.find("fAudioMaxDistanceMult")->mValue.getFloat());
+        return lorkhan::playbackGain(mLorkhanPlayback,distance,minimum,maximum,ptr.isInCell()&&ptr.getCell()->getCell()->isExterior(),head);
+    }
+
+    bool SoundManager::sayLorkhanMedia(
+        const MWWorld::ConstPtr& ptr, Files::IStreamPtr media, std::string_view name, float volumeBoost)
+    {
+        if(!mOutput->isInitialized())return false;
+        DecoderPtr decoder=loadLorkhanMedia(std::move(media),name);if(!decoder)return false;
+        if(mLorkhanPlayback.clipStartMs||mLorkhanPlayback.clipEndMs)
+            decoder=std::make_unique<LorkhanTrimDecoder>(std::move(decoder),mLorkhanPlayback.clipStartMs,mLorkhanPlayback.clipEndMs);
+        stopSay(ptr);const bool head=ptr==MWMechanics::getPlayer();
+        const bool spatial=!head&&mLorkhanPlayback.audioMode<=2;
+        StreamPtr sound=getStreamRef();SoundParams params;
+        params.mPos=lorkhanPosition(ptr);params.mVolume=volumeBoost*lorkhanGain(ptr);
+        params.mBaseVolume=volumeFromType(Type::Voice);params.mMinDistance=100;params.mMaxDistance=1000000;
+        params.mFlags=PlayMode::NoEnv|Type::Voice|(spatial?Play_3D:Play_2D);sound->init(params);
+        const bool played=spatial?mOutput->streamSound3D(std::move(decoder),sound.get(),true):mOutput->streamSound(std::move(decoder),sound.get(),true);
+        if(!played)return false;
+        const bool paused=mLorkhanPlayback.pauseOnGamePause&&MWBase::Environment::get().getWorld()->getTimeManager()->isPaused();
+        if(paused)mOutput->pauseStream(sound.get(),true);
+        mSaySoundsQueue.emplace(ptr.mRef,SaySound{ptr.mCell,std::move(sound),true,paused,volumeBoost});return true;
+    }
