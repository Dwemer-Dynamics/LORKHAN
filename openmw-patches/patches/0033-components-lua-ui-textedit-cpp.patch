     void LuaTextEdit::updateChildren()
     {
         WidgetExtension::updateChildren();
+        auto& input = MyGUI::InputManager::getInstance();
+        const bool hadFocus = input.getKeyFocusWidget() == mEditBox;
         // otherwise it won't be focusable
         mEditBox->detachFromWidget();
         mEditBox->attachToWidget(this);
+        // Focus once on creation or an explicit false-to-true request, never on every redraw.
+        const bool autoFocus = propertyValue("autoFocus", false);
