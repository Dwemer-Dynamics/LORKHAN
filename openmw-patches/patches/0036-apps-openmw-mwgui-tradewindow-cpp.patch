+    // LORKHAN: copy committed barter lines before transfer can invalidate the borrowed item references.
+    std::vector<MWBase::LuaManager::LorkhanBarterLine> copyLorkhanBarterLines(
+        const std::vector<MWGui::ItemStack>& stacks)
+    {
+        std::vector<MWBase::LuaManager::LorkhanBarterLine> lines;
+        for (const MWGui::ItemStack& stack : stacks)
+        {
+            if (stack.mBase.isEmpty() || stack.mCount == 0)
+                continue;
+            MWBase::LuaManager::LorkhanBarterLine line{ stack.mBase.getCellRef().getRefId().serializeText(),
+                std::string(stack.mBase.getClass().getName(stack.mBase)),
+                static_cast<int>(std::min<size_t>(stack.mCount, std::numeric_limits<int>::max())),
+                stack.mBase.getClass().getValue(stack.mBase) };
+            auto existing = std::find_if(lines.begin(), lines.end(), [&](const auto& item) {
+                return item.recordId == line.recordId && item.name == line.name && item.unitValue == line.unitValue;
+            });
+            if (existing != lines.end())
+                existing->count = existing->count > std::numeric_limits<int>::max() - line.count
+                    ? std::numeric_limits<int>::max()
+                    : existing->count + line.count;
+            else if (lines.size() < 32)
+                lines.push_back(std::move(line));
+        }
+        return lines;
+    }
