{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name": "foundation", "displayName": "ALMSIVI foundation checks", "generator": "Ninja", "binaryDir": "${sourceDir}/build/foundation", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_STANDARD": "20"}},
    {"name": "native-sanitize", "inherits": "foundation", "displayName": "ALMSIVI native bridge sanitizers", "binaryDir": "${sourceDir}/build/native-sanitize", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer", "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"}}
  ],
  "buildPresets": [
    {"name": "foundation", "configurePreset": "foundation", "targets": ["check"]},
    {"name": "native-sanitize", "configurePreset": "native-sanitize", "targets": ["almsivi_native_tests"]}
  ],
  "testPresets": [
    {"name": "foundation", "configurePreset": "foundation", "output": {"outputOnFailure": true}},
    {"name": "native-sanitize", "configurePreset": "native-sanitize", "output": {"outputOnFailure": true}}
  ]
}
