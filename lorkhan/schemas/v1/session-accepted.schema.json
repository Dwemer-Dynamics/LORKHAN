{
  "$id": "https://lorkhan.invalid/schemas/v1/session-accepted.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "config_revision": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "client_settings": {
      "$ref": "https://lorkhan.invalid/schemas/v1/client-settings.schema.json"
    },
    "event_cursor": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/sequence"
    },
    "generation": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/generation"
    },
    "message_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "schema": {
      "const": "lorkhan.session.accepted.v1",
      "type": "string"
    },
    "session_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "character_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid",
      "description": "Authoritative saved character identity. Explicit adoption may resolve an older untagged save to an existing binding."
    },
    "profile_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid",
      "description": "Authoritative session owner for this playthrough. The client must use it on subsequent messages."
    }
  },
  "required": [
    "schema",
    "message_id",
    "session_id",
    "generation",
    "capabilities",
    "config_revision",
    "client_settings",
    "event_cursor"
  ],
  "type": "object"
}
