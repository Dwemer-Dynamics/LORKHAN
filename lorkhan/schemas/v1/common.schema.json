{
  "$defs": {
    "content_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "interior",
                  "type": "string"
                },
                "name": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "grid_x": {
                  "type": "integer"
                },
                "grid_y": {
                  "type": "integer"
                },
                "kind": {
                  "const": "exterior",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "grid_x",
                "grid_y"
              ],
              "type": "object"
            }
          ]
        },
        "content_file": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "refnum": {
          "additionalProperties": false,
          "properties": {
            "content_file": {
              "minimum": 0,
              "type": "integer"
            },
            "index": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "index",
            "content_file"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "record_id",
        "refnum",
        "content_file",
        "cell",
        "display_name"
      ],
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "client_version": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "game": {
          "const": "tes3",
          "type": "string"
        },
        "lua_api_revision": {
          "const": 129,
          "type": "integer"
        },
        "openmw_commit": {
          "const": "f4bec41444214a7903bebd178389ca22ca13f646",
          "type": "string"
        },
        "openmw_version": {
          "const": "0.51.0",
          "type": "string"
        },
        "platform": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "variant": {
          "const": "openmw",
          "type": "string"
        }
      },
      "required": [
        "game",
        "variant",
        "openmw_version",
        "openmw_commit",
        "lua_api_revision",
        "client_version",
        "platform",
        "capabilities"
      ],
      "type": "object"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z",
      "type": "string"
    },
    "uuid": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://lorkhan.invalid/schemas/v1/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
}
