{
  "$id": "https://lorkhan.invalid/schemas/v1/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "items": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/identity"},
      "maxItems": 12,
      "type": "array",
      "uniqueItems": true
    },
    "content_fingerprint": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/content_fingerprint"},
    "created_at": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/timestamp"},
    "game": {"const": "tes3", "type": "string"},
    "generation": {"maximum": 9007199254740991, "minimum": 1, "type": "integer"},
    "installation_id": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"},
    "language": {"maxLength": 35, "minLength": 2, "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "type": "string"},
    "mode": {"enum": ["stt", "text"], "type": "string"},
    "player": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/identity"},
    "playthrough_id": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"},
    "profile_id": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/profile_id"},
    "request_id": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"},
    "runtime": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/runtime"},
    "runtime_generation": {"maximum": 9007199254740991, "minimum": 1, "type": "integer"},
    "schema": {"const": "lorkhan.input.v1", "type": "string"},
    "session_id": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"},
    "target": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/identity"},
    "text": {"maxLength": 16384, "minLength": 1, "type": "string"},
    "turn_id": {"$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"}
  },
  "required": [
    "schema", "installation_id", "profile_id", "playthrough_id", "session_id", "turn_id", "request_id",
    "generation", "runtime_generation", "created_at", "runtime", "content_fingerprint", "game", "mode",
    "language", "text", "player", "target", "audience"
  ],
  "type": "object"
}
