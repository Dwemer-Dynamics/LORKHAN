{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lorkhan.invalid/schemas/v1/controls.schema.json",
  "$defs": {
    "nullableUuid": {
      "oneOf": [
        {
          "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableRevision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "modelSlotKey": {
      "enum": [
        "standard",
        "fast",
        "powerful",
        "experimental"
      ],
      "type": "string"
    },
    "nullableModelSlotKey": {
      "oneOf": [
        {
          "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/modelSlotKey"
        },
        {
          "type": "null"
        }
      ]
    },
    "routingUuidOrEmpty": {
      "oneOf": [
        {
          "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
        },
        {
          "const": "",
          "type": "string"
        }
      ]
    },
    "effectiveSettings": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "lorkhan.effective-settings.v1",
          "type": "string"
        },
        "change_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_id": {
          "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableUuid"
        },
        "profile_revision": {
          "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableRevision"
        },
        "core_profile_id": {
          "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableUuid"
        },
        "core_profile_revision": {
          "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableRevision"
        },
        "settings": {
          "additionalProperties": false,
          "properties": {
            "behavior": {
              "additionalProperties": false,
              "properties": {
                "auto_greeting": {
                  "type": "boolean"
                },
                "rechat": {
                  "type": "boolean"
                },
                "rechat_delay_seconds": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 3600
                },
                "rechat_max_depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "rechat_probability_percent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "rechat_mode": {
                  "enum": [
                    "tight",
                    "conversational",
                    "group",
                    "random"
                  ],
                  "type": "string"
                },
                "rechat_strict_targeting": {
                  "type": "boolean"
                },
                "open_rechat": {
                  "type": "boolean"
                },
                "rechat_allow_actions": {
                  "type": "boolean"
                },
                "end_conversation_cooldown_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 300
                },
                "boredom": {
                  "type": "boolean"
                },
                "boredom_delay_seconds": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 86400
                },
                "combat_barks": {
                  "type": "boolean"
                },
                "combat_bark_period_seconds": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 600
                }
              },
              "required": [
                "auto_greeting",
                "rechat",
                "rechat_delay_seconds",
                "rechat_max_depth",
                "rechat_probability_percent",
                "rechat_mode",
                "rechat_strict_targeting",
                "open_rechat",
                "rechat_allow_actions",
                "end_conversation_cooldown_seconds",
                "boredom",
                "boredom_delay_seconds",
                "combat_barks",
                "combat_bark_period_seconds"
              ],
              "type": "object"
            },
            "memory": {
              "additionalProperties": false,
              "properties": {
                "recent_turn_limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "knowledge_limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              },
              "required": [
                "recent_turn_limit",
                "knowledge_limit"
              ],
              "type": "object"
            },
            "narrator": {
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "context_visibility": {
                  "type": "boolean"
                },
                "inline_mode": {
                  "enum": [
                    "Disabled",
                    "Narrator",
                    "NPC",
                    "Text Only"
                  ],
                  "type": "string"
                },
                "welcome_events": {
                  "type": "boolean"
                },
                "welcome_cooldown_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                },
                "random_events": {
                  "type": "boolean"
                },
                "random_chance_percent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "random_cooldown_rounds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "bored_events": {
                  "type": "boolean"
                },
                "bored_chance_percent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "quest_events": {
                  "type": "boolean"
                },
                "quest_chance_percent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "quest_cooldown_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "book_events": {
                  "type": "boolean"
                }
              },
              "required": [
                "enabled",
                "name",
                "context_visibility",
                "inline_mode",
                "welcome_events",
                "welcome_cooldown_minutes",
                "random_events",
                "random_chance_percent",
                "random_cooldown_rounds",
                "bored_events",
                "bored_chance_percent",
                "quest_events",
                "quest_chance_percent",
                "quest_cooldown_minutes",
                "book_events"
              ],
              "type": "object"
            },
            "presentation": {
              "additionalProperties": false,
              "properties": {
                "show_status_hud": {
                  "type": "boolean"
                },
                "transcript_rows": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 20
                },
                "tts_volume_boost": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                }
              },
              "required": [
                "show_status_hud",
                "transcript_rows",
                "tts_volume_boost"
              ],
              "type": "object"
            },
            "safety": {
              "additionalProperties": false,
              "properties": {
                "actions_enabled": {
                  "type": "boolean"
                },
                "allow_hostile": {
                  "type": "boolean"
                },
                "allow_creatures": {
                  "type": "boolean"
                }
              },
              "required": [
                "actions_enabled",
                "allow_hostile",
                "allow_creatures"
              ],
              "type": "object"
            }
          },
          "required": [
            "behavior",
            "memory",
            "narrator",
            "presentation",
            "safety"
          ],
          "type": "object"
        },
        "routing": {
          "additionalProperties": false,
          "properties": {
            "prompt_configuration_id": {
              "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/routingUuidOrEmpty"
            },
            "llm_configuration_id": {
              "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/routingUuidOrEmpty"
            },
            "llm_fast_configuration_id": {
              "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/routingUuidOrEmpty"
            },
            "llm_powerful_configuration_id": {
              "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/routingUuidOrEmpty"
            },
            "llm_experimental_configuration_id": {
              "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/routingUuidOrEmpty"
            },
            "llm_fallback_configuration_id": {
              "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/routingUuidOrEmpty"
            },
            "tts_configuration_id": {
              "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/routingUuidOrEmpty"
            },
            "llm_randomizer_enabled": {
              "type": "boolean"
            },
            "llm_fallback_enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "source_map": {
          "additionalProperties": false,
          "maxProperties": 64,
          "patternProperties": {
            "^(settings\\.(behavior\\.(auto_greeting|rechat|rechat_delay_seconds|rechat_max_depth|rechat_probability_percent|rechat_mode|rechat_strict_targeting|open_rechat|rechat_allow_actions|end_conversation_cooldown_seconds|boredom|boredom_delay_seconds|combat_barks|combat_bark_period_seconds)|memory\\.(recent_turn_limit|knowledge_limit)|narrator\\.(enabled|name|context_visibility|inline_mode|welcome_events|welcome_cooldown_minutes|random_events|random_chance_percent|random_cooldown_rounds|bored_events|bored_chance_percent|quest_events|quest_chance_percent|quest_cooldown_minutes|book_events)|presentation\\.(show_status_hud|transcript_rows|tts_volume_boost)|safety\\.(actions_enabled|allow_hostile|allow_creatures))|routing\\.(prompt_configuration_id|llm_configuration_id|llm_fast_configuration_id|llm_powerful_configuration_id|llm_experimental_configuration_id|llm_fallback_configuration_id|tts_configuration_id|llm_randomizer_enabled|llm_fallback_enabled))$": {
              "enum": [
                "default",
                "global",
                "core_profile",
                "npc",
                "narrator_profile"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "schema",
        "change_token",
        "profile_id",
        "profile_revision",
        "core_profile_id",
        "core_profile_revision",
        "settings",
        "routing",
        "source_map"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "lorkhan.controls.v1",
      "type": "string"
    },
    "message_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "request_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "session_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "generation": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/generation"
    },
    "target": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/identity"
    },
    "selected_model_slot_key": {
      "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/modelSlotKey"
    },
    "resolved_model_slot_key": {
      "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableModelSlotKey"
    },
    "selected_profile_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableUuid"
    },
    "narrator_profile_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableUuid"
    },
    "effective_settings": {
      "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/effectiveSettings"
    },
    "model_slots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/modelSlotKey"
          },
          "label": {
            "enum": [
              "Standard",
              "Fast",
              "Powerful",
              "Experimental"
            ],
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "configuration_id": {
            "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableUuid"
          },
          "configuration_name": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "$ref": "https://lorkhan.invalid/schemas/v1/controls.schema.json#/$defs/nullableRevision"
          },
          "driver": {
            "oneOf": [
              {
                "enum": [
                  "configured",
                  "mock"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "label",
          "available",
          "configuration_id",
          "configuration_name",
          "revision",
          "driver",
          "model"
        ],
        "type": "object"
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "profile_id",
          "name",
          "revision"
        ],
        "type": "object"
      }
    },
    "settings_editor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_token",
        "sections"
      ],
      "properties": {
        "change_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sections": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "label",
              "fields"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "enum": [
                  "global",
                  "core_profile",
                  "npc"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "fields": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "label",
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-z0-9_.]+$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "boolean",
                        "integer",
                        "string",
                        "choice"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "minimum": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "maximum": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "choices": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "value",
                          "label"
                        ],
                        "properties": {
                          "value": {
                            "type": "string",
                            "maxLength": 512
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "message_id",
    "request_id",
    "session_id",
    "generation",
    "target",
    "selected_model_slot_key",
    "resolved_model_slot_key",
    "selected_profile_id",
    "narrator_profile_id",
    "effective_settings",
    "model_slots",
    "profiles"
  ],
  "type": "object"
}
