{
  "$id": "https://lorkhan.invalid/schemas/v1/stt-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audio_bytes": {
      "maximum": 16777216,
      "minimum": 1,
      "type": "integer"
    },
    "codec": {
      "const": "wav",
      "type": "string"
    },
    "created_at": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/timestamp"
    },
    "generation": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/generation"
    },
    "language": {
      "maxLength": 35,
      "minLength": 2,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$",
      "type": "string"
    },
    "message_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "request_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "schema": {
      "const": "lorkhan.stt.request.v1",
      "type": "string"
    },
    "session_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    },
    "sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "turn_id": {
      "$ref": "https://lorkhan.invalid/schemas/v1/common.schema.json#/$defs/uuid"
    }
  },
  "required": [
    "schema",
    "message_id",
    "request_id",
    "turn_id",
    "session_id",
    "generation",
    "created_at",
    "codec",
    "language",
    "audio_bytes",
    "sha256"
  ],
  "type": "object"
}
